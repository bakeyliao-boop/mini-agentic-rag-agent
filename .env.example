# Copy this file to .env for local development.
# Never commit the real .env file or any API key.

# Alibaba Cloud Model Studio / DashScope
DASHSCOPE_API_KEY=
# Replace this value with the API Host shown in Model Studio when using
# a workspace-specific or non-Beijing endpoint.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Chat model
CHAT_MODEL=qwen3.7-plus
CHAT_TEMPERATURE=0

# Text embedding model for Markdown retrieval
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Local storage
KNOWLEDGE_ROOT=./knowledge
CHROMA_PERSIST_DIR=./data/chroma
