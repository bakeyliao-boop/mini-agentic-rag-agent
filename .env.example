# Copy this file to .env for local development.
# Never commit the real .env file or any API key.

# Alibaba Cloud Model Studio / DashScope
DASHSCOPE_API_KEY=
# Replace this value with the API Host shown in Model Studio when using
# a workspace-specific or non-Beijing endpoint.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Chat model
CHAT_MODEL=qwen3.6-flash
CHAT_TEMPERATURE=0

# Independent semantic judge / DeepSeek official API
SEMANTIC_JUDGE_MODEL=deepseek-v4-flash
SEMANTIC_JUDGE_BASE_URL=https://api.deepseek.com
SEMANTIC_JUDGE_API_KEY=

# Text embedding model for Markdown retrieval
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Local storage
KNOWLEDGE_ROOT=./knowledge/education-v1
CHROMA_PERSIST_DIR=./data/chroma
